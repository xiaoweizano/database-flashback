[Unit]
Description=MySQL PITR Agent
Documentation=https://github.com/a-shan/mysql-pitr
After=network.target
Wants=mysql.service

[Service]
Type=simple
# Daemon mode: serves binlog data to the mysql-pitr-server over mTLS.
# AGENT_PASSPHRASE decrypts /etc/agent/config.json; set it in /etc/agent/env.
ExecStart=/usr/local/bin/mysql-pitr-agent serve --config=/etc/agent/config.json --passphrase=${AGENT_PASSPHRASE}
Restart=always
RestartSec=5
EnvironmentFile=-/etc/agent/env
Environment=AGENT_PASSPHRASE=
Environment=PATH=/usr/local/bin:/usr/bin:/bin
StandardOutput=journal
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
